# ---------------------------------------------------------------------------
# EcoCharge — environment template. Copy to `.env` and fill in real values.
# NEVER commit a real .env file. No secrets belong in source control.
# ---------------------------------------------------------------------------

# --- Public client config (inlined into the browser bundle at build time) ---
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxx"
VITE_SUPABASE_PROJECT_ID="your-project-id"

# --- Server-side config (read inside server functions only) ---
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxx"
# Privileged key — server only, never expose to the client.
# SUPABASE_SERVICE_ROLE_KEY=""

# --- Local Docker Compose Postgres ---
POSTGRES_USER="ecocharge"
POSTGRES_PASSWORD="change-me-locally"
POSTGRES_DB="ecocharge"
POSTGRES_PORT="5432"
DATABASE_URL="postgres://ecocharge:change-me-locally@localhost:5432/ecocharge"

# --- Runtime ---
NODE_ENV="development"
APP_PORT="3000"
